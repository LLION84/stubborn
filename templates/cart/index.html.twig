{% extends 'base.html.twig' %}

{% block title %}Panier - Stubborn{% endblock %}

{% block body %}
    <h1>Votre panier</h1>

    {% if items is empty %}
        {# Panier vide #}
        <p>Votre panier est vide.</p>
        <a href="{{ path('app_products') }}">Continuer mes achats</a>
    {% else %}
        <div class="panier">
            {% for item in items %}
                <article class="ligne">
                    <img src="{{ asset('images/' ~ item.product.image) }}" alt="{{ item.product.name }}">
                    <p class="ligne-nom">{{ item.product.name }}</p>
                    <p>{{ item.product.price|number_format(2, ',', ' ') }} €</p>
                    <p>Taille {{ item.size }}{% if item.quantity > 1 %} × {{ item.quantity }}{% endif %}</p>

                    {# Un petit formulaire par ligne pour la retirer #}
                    <form method="post" action="{{ path('app_cart_remove', {key: item.key}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('remove-' ~ item.key) }}">
                        <button type="submit" class="bouton-secondaire">Retirer du panier</button>
                    </form>
                </article>
            {% endfor %}
        </div>

        <div class="panier-actions">
            <p class="total">Total : {{ total|number_format(2, ',', ' ') }} €</p>
            {# Ce bouton sera branché sur Stripe à l'étape 9 #}
            <a href="#" class="bouton bouton-commande">Finaliser ma commande</a>
            <a href="{{ path('app_products') }}" class="bouton bouton-continuer">Continuer mes achats</a>
        </div>
    {% endif %}
{% endblock %}