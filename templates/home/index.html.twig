{% extends 'base.html.twig' %}

{% block title %}Accueil - Stubborn{% endblock %}

{% block body %}
    <section class="presentation">
        <h1>Stubborn</h1>
        <p>
            Marque de sweat-shirts née à Londres, Stubborn propose des pièces
            confortables et affirmées, pour celles et ceux qui ne font aucun
            compromis sur leur style.
        </p>
    </section>

    <section class="grille">
        {% for product in products %}
            <article class="carte">
                <img src="{{ asset('images/' ~ product.image) }}" alt="{{ product.name }}">
                <div class="carte-infos">
                    <div>
                        <p class="carte-nom">{{ product.name }}</p>
                        <p class="carte-prix">{{ product.price|number_format(2, ',', ' ') }} €</p>
                    </div>

                    {# Le bouton VOIR seulement si connecté (exigé par le PDF) #}
                    {% if app.user %}
                        <a href="{{ path('app_product', {id: product.id}) }}" class="bouton">Voir</a>
                    {% endif %}
                </div>
            </article>
        {% endfor %}
    </section>
{% endblock %}