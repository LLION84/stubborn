{% extends 'base.html.twig' %}

{% block title %}Boutique - Stubborn{% endblock %}

{% block body %}
    <div class="boutique">

        {# Le filtre à gauche #}
        <aside class="filtre">
            <p class="filtre-titre">Fourchette de prix</p>

            <a href="{{ path('app_products') }}" class="{{ selected is empty ? 'actif' }}">Tous</a>

            {% for range in ranges %}
                <a href="{{ path('app_products', {range: range}) }}" class="{{ selected == range ? 'actif' }}">
                    {{ range|replace({'-': ' à '}) }} €
                </a>
            {% endfor %}
        </aside>

        {# Les sweats à droite #}
        <section class="grille">
            {% for product in products %}
                <article class="carte">
                    <img src="{{ asset('images/' ~ product.image) }}" alt="{{ product.name }}">
                    <div class="carte-infos">
                        <div>
                            <p class="carte-nom">{{ product.name }}</p>
                            <p class="carte-prix">{{ product.price|number_format(2, ',', ' ') }} €</p>
                        </div>
                        <a href="{{ path('app_product', {id: product.id}) }}" class="bouton">Voir</a>
                    </div>
                </article>
            {% else %}
                <p>Aucun sweat dans cette fourchette de prix.</p>
            {% endfor %}
        </section>

    </div>
{% endblock %}